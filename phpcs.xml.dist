<?xml version="1.0"?>
<ruleset name="BFAL runtime security">
    <description>Narrow initial PHPCS security checks for first-party runtime PHP.</description>

    <file>better-font-awesome-library.php</file>
    <file>inc/class-bfa-release-data-validator.php</file>
    <file>inc/class-bfa-release-channel.php</file>
    <file>inc/class-bfa-release-data-v2-validator.php</file>
    <file>inc/class-bfa-release-data-v2-adapter.php</file>
    <file>inc/class-bfa-release-data-v2-refresher.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="Squiz.PHP.Eval"/>
</ruleset>
